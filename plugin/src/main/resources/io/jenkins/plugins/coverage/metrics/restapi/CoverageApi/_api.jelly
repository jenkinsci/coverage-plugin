<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">

  <h2>${%title}</h2>
  
  <p>${%description}</p>

  <dl>
    <dt>
      <a href="../modified/api">${%modified.title}</a>
    </dt>
    <dd>
      ${%modified.description}
    </dd>

    <dt>
      <a href="../files/api">${%files.title}</a>
    </dt>
    <dd>
      ${%files.description}
    </dd>
  </dl>

</j:jelly>